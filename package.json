{
  "name": "diabook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n extraction,api,web -c yellow,blue,magenta \"pnpm --filter @diabook/extraction dev\" \"pnpm --filter @diabook/api dev\" \"pnpm --filter @diabook/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm --filter @diabook/extraction build && vitest run",
    "test:watch": "pnpm --filter @diabook/extraction build && vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @diabook/api db:migrate",
    "db:seed": "pnpm --filter @diabook/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
