# Copie ce fichier en .env (cp .env.example .env) puis remplis les valeurs.
# Le fichier .env contient ta clé : il ne doit JAMAIS être commité.

# Clé créée sur https://aistudio.google.com/apikey (offre gratuite)
GEMINI_API_KEY=

# Identifiant du modèle (liste : npm run models). « gemini-flash-lite-latest » = le Flash-Lite le plus récent :
# rapide, sans réflexion, peu de surcharge. Plus capable mais plus lent : gemini-3.5-flash.
GEMINI_MODEL=gemini-flash-lite-latest

# Délai maximum d'attente d'une réponse, en millisecondes
GEMINI_TIMEOUT_MS=30000

# Port du serveur Express (étape 4)
PORT=3100
