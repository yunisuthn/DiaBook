# Base de données locale (docker compose, port 5434).
# Choisis le mot de passe AVANT le premier « pnpm db:up » : PostgreSQL ne le lit qu'à la création.
POSTGRES_USER=diabook
POSTGRES_PASSWORD=changer-moi
POSTGRES_DB=diabook
# Doit reprendre les trois valeurs ci-dessus : postgresql://USER:MOT_DE_PASSE@localhost:5434/DB
DATABASE_URL=postgresql://diabook:changer-moi@localhost:5434/diabook?schema=public

# Authentification : secret de signature des JWT (générer avec : openssl rand -base64 48)
JWT_SECRET=changer-moi-avec-une-longue-chaine-aleatoire

# Compte administrateur créé par « pnpm db:seed »
ADMIN_EMAIL=admin@diabook.local
ADMIN_PASSWORD=changer-moi

# API
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Lecture des photos par l'API Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Stockage des photos (cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=
